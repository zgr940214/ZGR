#!/bin/sh
# SPDX-License-Identifier: MIT
# Import trusted, user-edited FAT files without evaluating shell input.
set -u
umask 077
root=
boot=
test_mode=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) [ "$#" -ge 2 ] || exit 2; root=$2; test_mode=1; shift 2 ;;
        --boot) [ "$#" -ge 2 ] || exit 2; boot=$2; shift 2 ;;
        *) echo 'Usage: rpi4-headless-setup [--root FIXTURE --boot FIXTURE]' >&2; exit 2 ;;
    esac
done
if [ "$test_mode" = 1 ]; then
    case "$root" in /*) ;; *) exit 2 ;; esac
    case "$boot" in /*) ;; *) exit 2 ;; esac
    [ "$root" != / ] && [ -f "$root/.rpi4-setup-test-root" ] && [ -d "$boot" ] || exit 2
    # Fixture paths must not follow host absolute symlinks (for example a
    # rootfs /etc/resolv.conf -> /run/resolv.conf). Production uses real /.
    [ ! -L "$root" ] && [ ! -L "$boot" ] || exit 2
    [ -z "$(find "$root" "$boot" -type l -print)" ] || exit 2
else
    [ -z "$boot" ] || exit 2
    [ "$(id -u)" = 0 ] || { echo 'rpi4-headless-setup requires root' >&2; exit 1; }
fi
mounted=0
work=$root/run/rpi4-headless-setup.$$
mkdir -p "$work" || exit 1
cleanup() {
    rm -rf "$work"
    if [ "$mounted" = 1 ]; then umount "$boot" || :; fi
}
trap cleanup EXIT HUP INT TERM
if [ "$test_mode" = 0 ]; then
    if awk '$2 == "/boot" && ($3 == "vfat" || $3 == "msdos") {found=1} END {exit !found}' /proc/mounts; then
        boot=/boot
    else
        boot=$root/run/rpi4-setup-boot
        mkdir -p "$boot" || exit 1
        if ! mount -t vfat -o rw /dev/mmcblk0p1 "$boot"; then
            echo 'rpi4-headless-setup: boot partition unavailable; existing setup retained' >&2
            exit 1
        fi
        mounted=1
    fi
fi
state=$root/var/lib/rpi4-setup
mkdir -p "$state" || exit 1
status=$work/status
printf '%s\n' 'RPi4 headless setup' > "$status"
failed=0
error() {
    printf '%s\n' "ERROR: $1; existing setting retained" >> "$status"
    echo "rpi4-headless-setup: $1" >&2
    failed=1
}
normalise() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    [ "$(wc -c < "$1")" -le "$3" ] || return 1
    awk 'NR==1 {sub(/^\357\273\277/, "")} {sub(/\r$/, ""); print}' "$1" > "$2"
}
hash_file() { sha256sum "$1" | awk '{print $1}'; }
already_applied() {
    [ -f "$state/$1.sha256" ] && [ "$(cat "$state/$1.sha256")" = "$2" ]
}
remember() { printf '%s\n' "$2" > "$state/$1.sha256"; }
atomic_copy() {
    cp "$1" "$2.rpi4-setup-new" && chmod "$3" "$2.rpi4-setup-new" || return 1
    if [ "$test_mode" = 0 ]; then chown 0:0 "$2.rpi4-setup-new" || return 1; fi
    mv -f "$2.rpi4-setup-new" "$2"
}
apply_network() {
    [ -e "$boot/network-config" ] || { echo 'Network: existing configuration' >> "$status"; return; }
    if ! normalise "$boot/network-config" "$work/network" 8192; then error 'invalid network-config file'; return; fi
    checksum=$(hash_file "$work/network")
    # Version 1 used GNU-only od options and could persist an empty SSID while
    # remembering a successful import. Re-import those cards once even when
    # the FAT file has not changed; later runs still preserve local edits.
    if already_applied network "$checksum" && [ "$(cat "$state/network-format" 2>/dev/null)" = 2 ]; then
        echo 'Network: unchanged; local edits preserved' >> "$status"; return
    fi
    # The values of SSID/PASSWORD are literal, including spaces and punctuation.
    # Never source/eval this file; reject control characters and malformed keys.
    if ! LC_ALL=C awk '
    function ipv4(s, a,n,i) {
        if (s !~ /^[0-9.]+$/) return 0
        n=split(s,a,"."); if(n!=4) return 0
        for(i=1;i<=4;i++) if(a[i]=="" || length(a[i])>3 || a[i]+0>255) return 0
        return 1
    }
    /^[[:space:]]*($|#)/ {next}
    {
        line=$0; sub(/^[[:space:]]*/,"",line)
        p=index(line,"="); if(!p) exit 1
        k=substr(line,1,p-1); v=substr(line,p+1)
        sub(/[[:space:]]*$/, "", k)
        if(k !~ /^(INTERFACE|MODE|ADDRESS|NETMASK|GATEWAY|DNS|SSID|PASSWORD|REGDOM)$/ || seen[k]++) exit 1
        if(k!="SSID" && k!="PASSWORD") {sub(/^[[:space:]]*/,"",v);sub(/[[:space:]]*$/,"",v)}
        if(v ~ /[[:cntrl:]]/) exit 1
        val[k]=v
    }
    END {
        if(seen["SSID"] || seen["PASSWORD"]) {
            if(!seen["INTERFACE"]) val["INTERFACE"]="wlan0"
            if(!seen["MODE"]) val["MODE"]="dhcp"
        }
        iface=val["INTERFACE"]
        if(iface !~ /^[A-Za-z][A-Za-z0-9_.:-]*$/ || length(iface)>15) exit 1
        if(val["MODE"]!="dhcp" && val["MODE"]!="static") exit 1
        if(val["ADDRESS"]!="" && !ipv4(val["ADDRESS"])) exit 1
        if(val["NETMASK"]!="" && !ipv4(val["NETMASK"])) exit 1
        if(val["GATEWAY"]!="" && !ipv4(val["GATEWAY"])) exit 1
        if(val["DNS"]!="") {n=split(val["DNS"],d,/ +/); for(i=1;i<=n;i++) if(!ipv4(d[i])) exit 1}
        if(val["MODE"]=="static" && (!ipv4(val["ADDRESS"]) || !ipv4(val["NETMASK"]))) exit 1
        if(val["REGDOM"]!="" && val["REGDOM"]!~/^[A-Z][A-Z]$/) exit 1
        if(iface=="wlan0") {
            ssid=val["SSID"]; password=val["PASSWORD"]
            if(length(ssid)<1 || length(ssid)>32 || ssid=="填写WiFi名" || ssid=="YOUR_WIFI_NAME" || ssid=="YOUR_WIFI_SSID") exit 1
            if(password=="填写WiFi密码" || password=="YOUR_WIFI_PASSWORD") exit 1
            if(!((length(password)>=8 && length(password)<=63) || (length(password)==64 && password~/^[A-Fa-f0-9]+$/))) exit 1
        } else if(seen["SSID"] || seen["PASSWORD"]) exit 1
        print "auto lo\niface lo inet loopback\n"
        # Ethernet remains available even when Wi-Fi is configured incorrectly.
        if(iface!="eth0") print "auto eth0\niface eth0 inet dhcp\n"
        print "auto " iface "\niface " iface " inet " val["MODE"]
        if(val["MODE"]=="static") {
            print "    address " val["ADDRESS"] "\n    netmask " val["NETMASK"]
            if(val["GATEWAY"]!="") print "    gateway " val["GATEWAY"]
        }
        if(iface=="wlan0") print "    wpa-driver nl80211\n    wpa-conf /etc/wpa_supplicant.conf"
    }' "$work/network" > "$work/interfaces"; then error 'network-config validation failed'; return; fi
    interface=$(awk 'index($0,"=") {k=substr($0,1,index($0,"=")-1);gsub(/[[:space:]]/,"",k);if(k=="INTERFACE"){v=substr($0,index($0,"=")+1);gsub(/[[:space:]]/,"",v);print v}}' "$work/network")
    [ -n "$interface" ] || interface=wlan0
    if [ "$interface" = wlan0 ]; then
        # Strip only the key; leading/trailing SSID/PSK spaces are meaningful.
        ssid=$(awk 'index($0,"=") {k=substr($0,1,index($0,"=")-1);gsub(/[[:space:]]/,"",k);if(k=="SSID")print substr($0,index($0,"=")+1)}' "$work/network")
        wifi_password=$(awk 'index($0,"=") {k=substr($0,1,index($0,"=")-1);gsub(/[[:space:]]/,"",k);if(k=="PASSWORD")print substr($0,index($0,"=")+1)}' "$work/network")
        regdom=$(awk 'index($0,"=") {k=substr($0,1,index($0,"=")-1);gsub(/[[:space:]]/,"",k);if(k=="REGDOM"){v=substr($0,index($0,"=")+1);gsub(/[[:space:]]/,"",v);print v}}' "$work/network")
        [ -n "$regdom" ] || regdom=CN
        wifi_psk=
        if [ "$(LC_ALL=C printf '%s' "$wifi_password" | wc -c)" = 64 ]; then
            wifi_psk=$wifi_password
        else
            # The passphrase is sent over stdin, never a process argument.
            # wpa_passphrase emits a plaintext comment: never install its output.
            if ! printf '%s\n' "$wifi_password" | wpa_passphrase "$ssid" > "$work/wpa-output" 2>/dev/null; then
                unset wifi_password
                error 'Wi-Fi PSK derivation failed'; return
            fi
            wifi_psk=$(awk '/^[[:space:]]*psk=/ {sub(/^[[:space:]]*psk=/,"");if(length($0)==64 && $0~/^[A-Fa-f0-9]+$/)print}' "$work/wpa-output")
        fi
        unset wifi_password
        if ! printf '%s\n' "$wifi_psk" | LC_ALL=C awk 'length($0)==64 && /^[A-Fa-f0-9]+$/ {ok=1} END {exit !ok}'; then
            error 'Wi-Fi PSK derivation returned invalid data'; return
        fi
        # A hex SSID handles UTF-8, quotes and backslashes without config escape
        # ambiguities; only the derived 256-bit PSK is persisted in rootfs.
        # The target BusyBox od has no -A/-t support. Use its hexdump applet,
        # keep repeated bytes (-v), and reject failures before replacing files.
        if ! printf '%s' "$ssid" > "$work/ssid" || ! ssid_hex=$(hexdump -v -e '1/1 "%02x"' "$work/ssid"); then
            error 'Wi-Fi SSID encoding failed'; return
        fi
        ssid_bytes=$(wc -c < "$work/ssid")
        if ! printf '%s\n' "$ssid_hex" | LC_ALL=C awk -v bytes="$ssid_bytes" 'length($0)==2*bytes && /^[0-9a-f]+$/ {ok=1} END {exit !ok}'; then
            error 'Wi-Fi SSID encoding returned invalid data'; return
        fi
        {
            printf '%s\n' 'ctrl_interface=/var/run/wpa_supplicant' 'update_config=0' "country=$regdom" 'network={'
            printf '    ssid=%s\n' "$ssid_hex"
            printf '    psk=%s\n' "$wifi_psk"
            printf '%s\n' '    key_mgmt=WPA-PSK' '    ieee80211w=1' '    scan_ssid=1' '}'
        } > "$work/wpa_supplicant.conf"
        unset wifi_psk ssid
        if ! atomic_copy "$work/wpa_supplicant.conf" "$root/etc/wpa_supplicant.conf" 0600; then error 'cannot install Wi-Fi configuration'; return; fi
    fi
    mkdir -p "$root/etc/network" || { error 'cannot create network configuration directory'; return; }
    if ! atomic_copy "$work/interfaces" "$root/etc/network/interfaces" 0644; then error 'cannot install network configuration'; return; fi
    mode=$(awk -F= '$1 ~ /^[[:space:]]*MODE[[:space:]]*$/ {gsub(/[[:space:]]/,"",$2);print $2}' "$work/network")
    [ -n "$mode" ] || mode=dhcp
    if [ "$mode" = static ]; then
        awk -F= '$1 ~ /^[[:space:]]*DNS[[:space:]]*$/ {n=split($2,d,/ +/);for(i=1;i<=n;i++)if(d[i]!="")print "nameserver " d[i]}' "$work/network" > "$work/resolv.conf"
        if [ -s "$work/resolv.conf" ]; then
            # Follow the distribution-provided /etc/resolv.conf symlink if any.
            if ! cat "$work/resolv.conf" > "$root/etc/resolv.conf"; then error 'cannot install DNS configuration'; return; fi
        fi
    fi
    remember network "$checksum"
    printf '%s\n' 2 > "$state/network-format"
    echo "Network: applied ($mode)" >> "$status"
    [ "$interface" != wlan0 ] || echo 'Wi-Fi: WPA2-PSK configured; Ethernet DHCP retained' >> "$status"
}
prepare_wifi_hardware() {
    [ "$test_mode" = 0 ] || return
    [ -f /etc/wpa_supplicant.conf ] || return
    grep -Eq '^[[:space:]]*ssid=' /etc/wpa_supplicant.conf || return
    # eudev (S04), module loading (S06) and /run setup (S37) precede us.
    # Explicit loading plus a bounded wait handles asynchronous SDIO probing.
    if ! modprobe brcmfmac >/dev/null 2>&1; then
        error 'brcmfmac module could not be loaded; Ethernet DHCP remains available'
        return
    fi
    if ! rfkill unblock wifi >/dev/null 2>&1; then
        echo 'Wi-Fi: rfkill unblock was unavailable; checking interface discovery' >> "$status"
    fi
    wifi_wait=0
    while [ ! -d /sys/class/net/wlan0 ] && [ "$wifi_wait" -lt 10 ]; do
        sleep 1
        wifi_wait=$((wifi_wait + 1))
    done
    if [ ! -d /sys/class/net/wlan0 ]; then
        error 'wlan0 did not appear within 10 seconds; Ethernet DHCP remains available'
    else
        echo 'Wi-Fi: wlan0 ready before networking starts' >> "$status"
    fi
}
apply_keys() {
    [ -e "$boot/authorized_keys" ] || { echo 'SSH public keys: no import file' >> "$status"; return; }
    if ! normalise "$boot/authorized_keys" "$work/keys-input" 65536; then error 'invalid authorized_keys file'; return; fi
    checksum=$(hash_file "$work/keys-input")
    if already_applied authorized_keys "$checksum"; then echo 'SSH public keys: unchanged; local edits preserved' >> "$status"; return; fi
    : > "$work/keys"
    valid=1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|\#*) continue ;; esac
        printf '%s\n' "$line" > "$work/one-key"
        if ! awk 'NF>=2 && $1 ~ /^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$/ && $2 ~ /^[A-Za-z0-9+\/=]+$/ {ok=1} END {exit !ok}' "$work/one-key" || ! ssh-keygen -l -f "$work/one-key" >/dev/null 2>&1; then
            valid=0; break
        fi
        printf '%s\n' "$line" >> "$work/keys"
    done < "$work/keys-input"
    if [ "$valid" != 1 ] || [ ! -s "$work/keys" ]; then error 'authorized_keys validation failed'; return; fi
    home=$(awk -F: '$1=="root" {print $6}' "$root/etc/passwd")
    case "$home" in /*) ;; *) error 'root home directory is invalid'; return ;; esac
    case "$home" in *'/../'*|*/..|*'/./'*|*/.) error 'root home directory is unsafe'; return ;; esac
    sshdir=$root$home/.ssh
    if ! mkdir -p "$sshdir" || ! chmod 0700 "$sshdir"; then error 'cannot prepare root SSH directory'; return; fi
    if [ "$test_mode" = 0 ]; then chown 0:0 "$sshdir" || { error 'cannot set root SSH ownership'; return; }; fi
    if ! atomic_copy "$work/keys" "$sshdir/authorized_keys" 0600; then error 'cannot install SSH public keys'; return; fi
    remember authorized_keys "$checksum"
    echo 'SSH public keys: imported for root' >> "$status"
}
apply_password() {
    [ -e "$boot/userconf.txt" ] || return
    if ! normalise "$boot/userconf.txt" "$work/userconf" 2048; then error 'invalid userconf.txt file'; return; fi
    # Only SHA-512 crypt, exactly one root account; never accept cleartext.
    if ! awk -F: '
        NF==0 || /^#/ {next}
        {if(++count!=1 || NF!=2 || $1!="root") exit 1
         n=split($2,a,"\\$"); if(a[1]!="" || a[2]!="6") exit 1
         if(n==5) {if(a[3]!~/^rounds=[0-9]+$/) exit 1; salt=a[4]; hash=a[5]}
         else if(n==4) {salt=a[3]; hash=a[4]} else exit 1
         if(length(salt)<1 || length(salt)>16 || salt!~/^[A-Za-z0-9.\/]+$/ || length(hash)!=86 || hash!~/^[A-Za-z0-9.\/]+$/) exit 1}
        END {if(count!=1) exit 1}' "$work/userconf"; then error 'userconf.txt must contain root and a SHA-512 crypt hash'; return; fi
    password_hash=$(awk -F: '$1=="root" {print $2}' "$work/userconf")
    database=$root/etc/passwd
    [ ! -f "$root/etc/shadow" ] || database=$root/etc/shadow
    if ! awk -F: -v OFS=: -v h="$password_hash" '$1=="root" {$2=h; found++} {print} END {if(found!=1) exit 1}' "$database" > "$work/password-db"; then error 'root password database could not be updated'; return; fi
    dbmode=0644
    [ "$database" != "$root/etc/shadow" ] || dbmode=0600
    if ! atomic_copy "$work/password-db" "$database" "$dbmode"; then error 'root password import failed'; return; fi
    if ! rm -f "$boot/userconf.txt"; then error 'password imported but userconf.txt removal failed'; return; fi
    echo 'Root password: SHA-512 hash imported; userconf.txt removed' >> "$status"
}
apply_network
prepare_wifi_hardware
apply_keys
apply_password
if [ "$failed" = 0 ]; then
    echo 'Result: configuration applied; see network-status.txt for connection status' >> "$status"
    cp "$status" "$state/headless-setup.done"
else
    echo 'Result: one or more imports rejected; inspect messages above' >> "$status"
fi
if ! cp "$status" "$boot/setup-result.txt.tmp" || ! mv -f "$boot/setup-result.txt.tmp" "$boot/setup-result.txt"; then
    echo 'rpi4-headless-setup: could not write setup-result.txt' >&2
fi
sync
exit "$failed"
